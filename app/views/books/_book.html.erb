<div id="<%= dom_id book %>">
  <div>
    <strong>Title:</strong>
    <%= book.title %>
  </div>

  <div>
    <strong>Isbn:</strong>
    <%= book.isbn %>
  </div>

  <div>
    <strong>Year:</strong>
    <%= book.year %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= book.description %>
  </div>

  <div>
    <strong>Copies count:</strong>
    <%= book.copies_count %>
  </div>

  <div>
    <strong>Genre:</strong>
    <%= book.genre_id %>
  </div>

</div>
