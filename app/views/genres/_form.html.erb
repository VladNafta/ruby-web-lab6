<%# [згенеровано] rails generate scaffold Genre; [власний код] вивід помилок через form_errors %>
<%= form_with(model: genre, class: "form") do |form| %>
  <%= form_errors(genre) %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div>
    <%= form.submit class: "btn primary" %>
  </div>
<% end %>
